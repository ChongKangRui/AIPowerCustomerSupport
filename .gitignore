# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright — nested under e2e/ per playwright.config.ts's outputDir/reporter
/e2e/test-results/
/e2e/playwright-report/
/playwright/.cache/
/blob-report/
# storageState snapshots from e2e/auth.setup.ts — live session cookies for
# the test database, not secrets to share/commit.
/e2e/.auth/

# next.js
/.next/
/.next-test/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# prisma generated client (regenerated via `npm run db:generate`)
/lib/generated/

# Claude Code's running error/root-cause/fix log — personal debugging notes
# for this project, not documentation meant to be shared or reviewed.
/error-log.txt

# Personal "how the whole project works" explainer — a reference doc for
# understanding the codebase, not the project's actual documentation
# (project-scope.md/tech-stack.md/implementation-plan.md are, and those stay
# committed).
/HOW-IT-WORKS.md

# commit the env template
!.env.example
.secrets
