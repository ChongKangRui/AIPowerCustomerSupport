// Prisma schema — see implementation-plan.md Phase 0.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  AGENT
}

/// Open -> Resolved -> Closed. Closed is terminal (project-scope.md).
enum TicketStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageAuthorType {
  CUSTOMER
  AGENT
  AI
  SYSTEM
}

/// Phase 5: events that create an in-app Notification for an agent.
/// TICKET_ASSIGNED: round-robin or manual assignment. TICKET_REOPENED: a
/// resolved ticket reopened via customer reply — distinct from ASSIGNED
/// since the assignee may not have changed. TICKET_NEW_MESSAGE: a reply
/// on an already-OPEN, already-assigned ticket.
enum NotificationType {
  TICKET_ASSIGNED
  TICKET_REOPENED
  TICKET_NEW_MESSAGE
}

// ---------------------------------------------------------------------------
// Auth.js models (User is extended with app-specific fields)
//
// Only User + Session here — PrismaAdapter (auth.ts) needs both for the
// database session strategy. Auth.js's usual boilerplate also ships an
// Account model (linked OAuth identities) and a VerificationToken model
// (magic-link/email verification), but this app registers no OAuth
// providers and does credentials-only login by hand (see auth.ts), so
// both would sit empty forever. Dropped them rather than carry unused
// tables — add them back if OAuth or email verification ever lands.
// ---------------------------------------------------------------------------

model User {
  id    String  @id @default(cuid())
  name  String?
  // Permanently unique, even across a soft-deleted row — an email is
  // reserved forever once used, deleted or not. Deliberate, see
  // implementation-plan.md.
  //
  // Only login and the admin list filter on deletedAt; create/edit's
  // conflict checks don't.
  email String  @unique
  image String?

  /// bcrypt hash — credentials login for this single-org demo
  passwordHash String?
  role         Role   @default(AGENT)

  /// Soft-delete marker. Null = active, set = deleted. The row is never
  /// mutated otherwise, so historical Ticket/TicketMessage references
  /// (assignedTo/author) keep resolving — see email's comment above.
  deletedAt DateTime?

  sessions Session[]

  assignedTickets Ticket[]        @relation("AssignedAgent")
  authoredMessages TicketMessage[] @relation("MessageAuthor")
  notifications   Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Support domain
// ---------------------------------------------------------------------------

model Ticket {
  id      String       @id @default(cuid())
  subject String
  status  TicketStatus @default(OPEN)

  customerEmail String
  customerName  String?

  /// Gmail thread this ticket mirrors — the key inbound messages are matched on
  gmailThreadId String @unique

  assignedToId String?
  assignedTo   User?   @relation("AssignedAgent", fields: [assignedToId], references: [id], onDelete: SetNull)

  /// True when Path A (AI auto-resolve) closed this out with no human involved
  resolvedByAi Boolean @default(false)

  // AI summarization output (Phase 4)
  summary   String?
  category  String?
  sentiment String?

  messages      TicketMessage[]
  notifications Notification[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?
  closedAt   DateTime?

  @@index([status])
  @@index([assignedToId])
  @@index([customerEmail])
  @@index([createdAt])
}

model TicketMessage {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  direction  MessageDirection
  authorType MessageAuthorType

  /// Set when authorType is AGENT
  authorId String?
  author   User?   @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  body String

  /// Gmail message id — unique so replayed polls can't double-insert
  gmailMessageId String  @unique
  /// Message-Id header, used to build In-Reply-To/References on outbound replies
  rfcMessageId   String?
  inReplyTo      String?

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

/// Phase 5: in-app notification for an agent, created at the moment a
/// ticket lands on their desk. Both FKs are required and Cascade — a
/// notification has no meaning without the ticket/user it points at,
/// unlike Ticket.assignedToId's SetNull, which exists to keep a deleted
/// user's *historical* attribution readable.
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  type    NotificationType
  message String

  /// Null = unread. Set = read, at this timestamp.
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model KnowledgeBaseEntry {
  id       String  @id @default(cuid())
  /// @unique so prisma/seed.ts can upsert by title, the same idiom
  /// it already uses for User.email.
  title    String  @unique
  content  String
  category String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Single-row table holding the last Gmail historyId processed by the poller.
model EmailSyncState {
  id            String   @id @default("gmail")
  lastHistoryId String
  lastPolledAt  DateTime @updatedAt
}

/// Storage table for `rate-limiter-flexible`'s RateLimiterPrisma
/// (lib/rate-limiter.ts). Shape (key/points/expire) and model name are
/// fixed by that library — see its Prisma driver docs.
///
/// Backs login brute-force protection on /api/login. No Redis needed,
/// since it reuses this Postgres connection.
model RateLimiterFlexible {
  key    String    @id
  points Int
  expire DateTime?
}
