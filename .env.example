# Copy to `.env` and fill in. Every var here must also exist in Vercel project settings.

# --- Database (Phase 0) -----------------------------------------------------
# See lib/database-url.ts for exactly how these resolve to one connection string.
#
# Production (Vercel): a full Neon connection string. When set, this wins outright.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"
#
# Local development: leave DATABASE_URL unset and fill these in instead — a
# local Postgres connection string is built from the pieces (defaults shown
# are also the fallback for any piece left blank, except DB_PASSWORD).
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="postgres"
DB_PASSWORD=""
DB_NAME="CustomerSupportDB"

# --- Test database (Playwright e2e) -----------------------------------------
# See lib/database-url.ts (resolveTestDatabaseUrl) and e2e/global-setup.ts.
# `npm run test:e2e` runs against a database entirely separate from dev/prod,
# reset + reseeded before every run, so tests never touch real data.
#
# Local Postgres (default): leave both unset — reuses DB_HOST/DB_PORT/DB_USER/
# DB_PASSWORD above, against a database named "${DB_NAME}_test". Playwright's
# global setup creates that database automatically if it doesn't exist yet.
# DB_NAME_TEST="CustomerSupportDB_test"
#
# Cloud (e.g. a dedicated Neon test branch): set a full URL instead — wins
# outright, same as DATABASE_URL above, and is assumed to already exist.
# DATABASE_URL_TEST="postgresql://user:password@host.neon.tech/dbname_test?sslmode=require"

# --- Seed data (prisma/seed.ts) ---------------------------------------------
# Credentials for the two demo accounts created by `npm run db:seed`. Also
# what the "Demo agent" / "Demo admin" buttons on the login page fill in —
# app/login/page.tsx (a Server Component) reads these directly and passes
# them down as props, so no NEXT_PUBLIC_ copy is needed. Demo credentials
# only, deliberately not secret — see tech-stack.md → Auth.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin1234"
SEED_AGENT_EMAIL="agent@example.com"
SEED_AGENT_PASSWORD="agent1234"

# --- Auth.js (Phase 0) ------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Canonical URL of the deployment. Vercel sets this automatically; needed locally.
AUTH_URL="http://localhost:3000"
# Set to true when running behind Vercel's proxy
AUTH_TRUST_HOST="true"

# --- Gmail API (Phase 2) ----------------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials (OAuth client, Web application)
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
# Obtained via the OAuth Playground flow, authorized as the demo Gmail account
GMAIL_REFRESH_TOKEN=""
# The dedicated demo inbox address, e.g. ai-support-demo@gmail.com
GMAIL_USER=""

# Shared secret for the poll endpoint. cron-job.org must send:
#   Authorization: Bearer <CRON_SECRET>
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# --- AI (Phase 4) -----------------------------------------------------------
# Google AI Studio API key (free tier)
GEMINI_API_KEY=""
